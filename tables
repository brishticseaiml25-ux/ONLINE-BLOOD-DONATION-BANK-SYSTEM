-- Create donors table
CREATE TABLE IF NOT EXISTS donors (
  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  phone TEXT NOT NULL,
  address TEXT NOT NULL,
  state TEXT NOT NULL,
  pin_code TEXT NOT NULL,
  blood_type TEXT NOT NULL,
  unique_code TEXT NOT NULL UNIQUE,
  created_at TIMESTAMP DEFAULT NOW()
);

-- Create hospitals table
CREATE TABLE IF NOT EXISTS hospitals (
  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  address TEXT NOT NULL,
  contact_info TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT NOW()
);

-- Create blood inventory table
CREATE TABLE IF NOT EXISTS blood_inventory (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  hospital_id UUID NOT NULL REFERENCES hospitals(id) ON DELETE CASCADE,
  blood_type TEXT NOT NULL,
  quantity INTEGER DEFAULT 0,
  updated_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(hospital_id, blood_type)
);

-- Create camps table
CREATE TABLE IF NOT EXISTS camps (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  hospital_id UUID NOT NULL REFERENCES hospitals(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  date DATE NOT NULL,
  time TEXT NOT NULL,
  location TEXT NOT NULL,
  description TEXT,
  created_at TIMESTAMP DEFAULT NOW()
);

-- Create camp registrations table
CREATE TABLE IF NOT EXISTS camp_registrations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  camp_id UUID NOT NULL REFERENCES camps(id) ON DELETE CASCADE,
  donor_id UUID NOT NULL REFERENCES donors(id) ON DELETE CASCADE,
  registered_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(camp_id, donor_id)
);

-- Create donation records table
CREATE TABLE IF NOT EXISTS donations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  donor_id UUID NOT NULL REFERENCES donors(id) ON DELETE CASCADE,
  hospital_id UUID NOT NULL REFERENCES hospitals(id) ON DELETE CASCADE,
  camp_id UUID REFERENCES camps(id) ON DELETE SET NULL,
  donated_at TIMESTAMP DEFAULT NOW()
);

-- Enable RLS on all tables
ALTER TABLE donors ENABLE ROW LEVEL SECURITY;
ALTER TABLE hospitals ENABLE ROW LEVEL SECURITY;
ALTER TABLE blood_inventory ENABLE ROW LEVEL SECURITY;
ALTER TABLE camps ENABLE ROW LEVEL SECURITY;
ALTER TABLE camp_registrations ENABLE ROW LEVEL SECURITY;
ALTER TABLE donations ENABLE ROW LEVEL SECURITY;

-- Donors RLS policies
CREATE POLICY "Donors can view their own data" ON donors
  FOR SELECT USING (auth.uid() = id);

CREATE POLICY "Donors can update their own data" ON donors
  FOR UPDATE USING (auth.uid() = id);

-- Hospitals RLS policies
CREATE POLICY "Hospitals can view their own data" ON hospitals
  FOR SELECT USING (auth.uid() = id);

CREATE POLICY "Hospitals can update their own data" ON hospitals
  FOR UPDATE USING (auth.uid() = id);

CREATE POLICY "Public can view all hospitals" ON hospitals
  FOR SELECT USING (true);

-- Blood inventory RLS policies
CREATE POLICY "Hospitals can manage their inventory" ON blood_inventory
  FOR ALL USING (hospital_id IN (SELECT id FROM hospitals WHERE id = auth.uid()));

CREATE POLICY "Public can view all blood inventory" ON blood_inventory
  FOR SELECT USING (true);

-- Camps RLS policies
CREATE POLICY "Hospitals can manage their camps" ON camps
  FOR ALL USING (hospital_id IN (SELECT id FROM hospitals WHERE id = auth.uid()));

CREATE POLICY "Public can view all camps" ON camps
  FOR SELECT USING (true);

-- Camp registrations RLS policies
CREATE POLICY "Donors can view their registrations" ON camp_registrations
  FOR SELECT USING (donor_id = auth.uid());

CREATE POLICY "Donors can register for camps" ON camp_registrations
  FOR INSERT WITH CHECK (donor_id = auth.uid());

CREATE POLICY "Public can view registrations" ON camp_registrations
  FOR SELECT USING (true);

-- Donations RLS policies
CREATE POLICY "Donors can view their donations" ON donations
  FOR SELECT USING (donor_id = auth.uid());

CREATE POLICY "Hospitals can record donations" ON donations
  FOR INSERT WITH CHECK (hospital_id IN (SELECT id FROM hospitals WHERE id = auth.uid()));

CREATE POLICY "Donors can view confirmed donations" ON donations
  FOR SELECT USING (donor_id = auth.uid());
